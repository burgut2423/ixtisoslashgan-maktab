rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'burgutsony@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 3 && data.email.size() <= 200
        && data.role == 'admin'
        && data.updatedAt is timestamp
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150));
    }

    function isValidPortalConfig(data) {
      return data.keys().hasAll(['spreadsheetId', 'schoolTitle', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['spreadsheetId', 'rootFolderId', 'schoolTitle', 'updatedBy', 'updatedAt'])
        && data.spreadsheetId is string && data.spreadsheetId.size() <= 200
        && data.schoolTitle is string && data.schoolTitle.size() > 0 && data.schoolTitle.size() <= 240
        && data.updatedBy is string && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp
        && (!('rootFolderId' in data) || (data.rootFolderId is string && data.rootFolderId.size() <= 200));
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || (isVerifiedUser() && request.auth.uid == adminId));
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && isAdmin() && isValidAdminUser(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(adminId) && isAdmin() && isValidAdminUser(incoming()) && incoming().uid == existing().uid && incoming().updatedAt == request.time;
      allow delete: if isValidId(adminId) && isAdmin();
    }

    match /portal_configs/{configId} {
      allow get: if isValidId(configId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(configId) && isAdmin() && isValidPortalConfig(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(configId) && isAdmin() && isValidPortalConfig(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isValidId(configId) && isAdmin();
    }
  }
}
